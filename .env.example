# Firebase web config (not secret): Firebase console → Project settings → Your apps → Web app.
# Restart Expo after changing these. EAS cloud builds take the same values from eas.json.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web portal for proctored mock tests (Mock Tests screen).
EXPO_PUBLIC_PORTAL_URL=https://cohortlive-portal.netlify.app
